---
import type { RegionSunRow } from '@utils/region-hub';

const {
  rows,
  heading,
  intro,
  cityLabel = 'City',
  sunriseLabel = 'Sunrise',
  sunsetLabel = 'Sunset',
  daylightLabel = 'Daylight',
} = Astro.props as {
  rows: RegionSunRow[];
  heading: string;
  intro: string;
  cityLabel?: string;
  sunriseLabel?: string;
  sunsetLabel?: string;
  daylightLabel?: string;
};
---

<section class="resource-section region-sun-comparison" aria-labelledby="region-sun-comparison-heading">
  <div class="detail-section-head">
    <h2 id="region-sun-comparison-heading">
      <i data-lucide="table-2" class="icon-md"></i>
      {heading}
    </h2>
    <p>{intro}</p>
  </div>

  <div class="data-table-wrap glass-card">
    <table class="data-table">
      <thead>
        <tr>
          <th>{cityLabel}</th>
          <th>{sunriseLabel}</th>
          <th>{sunsetLabel}</th>
          <th>{daylightLabel}</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr>
            <td>
              <a href={row.path}>
                <strong>{row.name}</strong>
                <span>{row.location}</span>
              </a>
            </td>
            <td>{row.sunrise}</td>
            <td>{row.sunset}</td>
            <td>{row.daylight}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<style>
  .region-sun-comparison {
    margin-top: clamp(2rem, 5vw, 4rem);
  }

  .data-table-wrap {
    overflow-x: auto;
    padding: 0;
  }

  .data-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 640px;
  }

  .data-table th,
  .data-table td {
    padding: 0.95rem 1rem;
    border-bottom: 1px solid var(--border-color);
    text-align: left;
    vertical-align: top;
  }

  :global([dir="rtl"]) .data-table th,
  :global([dir="rtl"]) .data-table td {
    text-align: right;
  }

  .data-table th {
    color: var(--text-secondary);
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .data-table tr:last-child td {
    border-bottom: 0;
  }

  .data-table a {
    color: inherit;
    display: grid;
    gap: 0.25rem;
    text-decoration: none;
  }

  .data-table a span {
    color: var(--text-secondary);
    font-size: 0.88rem;
  }
</style>
